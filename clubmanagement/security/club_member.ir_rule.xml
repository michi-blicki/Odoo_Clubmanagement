<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="club_member_need_to_know_rule" model="ir.rule">
            <field name="name">ClubMember: Need-to-Know Filter</field>
            <field name="model_id" ref="model_club_member"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.has_group('clubmanagement.group_clubmanagement_master_user') else [
                    '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                    ('current_state_id.state_type', 'in', ['pending', 'waiting', 'registered', 'blocked']),
                    ('partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('team_ids.role_ids.scope_type', '=', 'team'), ('team_ids.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('pool_ids.role_ids.scope_type', '=', 'pool'), ('pool_ids.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('team_ids.pool_id.role_ids.scope_type', '=', 'pool'), ('team_ids.pool_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('department_ids.role_ids.scope_type', '=', 'department'), ('department_ids.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('pool_ids.department_id.role_ids.scope_type', '=', 'department'), ('pool_ids.department_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('team_ids.department_id.role_ids.scope_type', '=', 'department'), ('team_ids.department_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('subclub_ids.role_ids.scope_type', '=', 'subclub'), ('subclub_ids.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('department_ids.subclub_id.role_ids.scope_type', '=', 'subclub'), ('department_ids.subclub_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('pool_ids.subclub_id.role_ids.scope_type', '=', 'subclub'), ('pool_ids.subclub_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('team_ids.department_id.subclub_id.role_ids.scope_type', '=', 'subclub'), ('team_ids.department_id.subclub_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('club_id.role_ids.scope_type', '=', 'club'), ('club_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('subclub_ids.club_id.role_ids.scope_type', '=', 'club'), ('subclub_ids.club_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('department_ids.club_id.role_ids.scope_type', '=', 'club'), ('department_ids.club_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('pool_ids.club_id.role_ids.scope_type', '=', 'club'), ('pool_ids.club_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id]),
                    '&amp;', ('team_ids.club_id.role_ids.scope_type', '=', 'club'), ('team_ids.club_id.role_ids.member_id.partner_id.user_ids', 'in', [user.id])
                ]
            </field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_user'))]"/>
        </record>

        <record id="club_member_master_user_rule" model="ir.rule">
            <field name="name">ClubMember: Master User override</field>
            <field name="model_id" ref="model_club_member"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_master_user'))]"/>
        </record>
    
        <record id="club_member_admin_rule" model="ir.rule">
            <field name="name">ClubMember: Administrator override</field>
            <field name="model_id" ref="model_club_member"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_administrator'))]"/>
        </record>
    </data>
    

</odoo>
