<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="club_subclub_company_rule" model="ir.rule">
            <field name="name">Subclub: Only records from user company</field>
            <field name="model_id" ref="clubmanagement.model_club_subclub"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_user'))]"/>
        </record>

        <record id="rule_club_subclub_need_to_know" model="ir.rule">
            <field name="name">SubClub: Need-to-Know Filter</field>
            <field name="model_id" ref="model_club_subclub"/>
            <field name="domain_force">
                [('role_ids.member_id.partner_id.user_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_user'))]"/>
        </record>

        <record id="club_subclub_master_user_rule" model="ir.rule">
            <field name="name">Subclub: All rights for Club Master Users</field>
            <field name="model_id" ref="clubmanagement.model_club_subclub"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_master_user'))]"/>
        </record>
        
        <record id="club_subclub_admin_rule" model="ir.rule">
            <field name="name">Subclub: All rights for Club Administrators</field>
            <field name="model_id" ref="clubmanagement.model_club_subclub"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_administrator'))]"/>
        </record>
    
    </data>
    
</odoo>
