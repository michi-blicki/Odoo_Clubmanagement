<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="rule_only_own_club_fields" model="ir.rule">
            <field name="name">Club: Custom Fields own club only</field>
            <field name="model_id" ref="model_club_custom_field"/>
            <field name="domain_force">[('company_ids', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_user'))]"/>
        </record>

        <record id="club_departmant_master_user_rule" model="ir.rule">
            <field name="name">Department: All rights for Club Master Users</field>
            <field name="model_id" ref="clubmanagement.model_club_department"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_master_user'))]"/>
        </record>
    
        <record id="club_departmant_admin_rule" model="ir.rule">
            <field name="name">Department: All rights for Club Administrators</field>
            <field name="model_id" ref="clubmanagement.model_club_department"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('clubmanagement.group_clubmanagement_administrator'))]"/>
        </record>

    </data>
    

</odoo>
