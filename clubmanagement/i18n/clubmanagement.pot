#. module: clubmanagement
#: model:mail.template,body_html:clubmanagement.mail_template_member_manual_dispatch
msgid ""
"<div style=\"font-family: Verdana, Arial, sans-serif; color: #222222; max-width: 900px;\">\n"
"                <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"vertical-align: top; width: 42%; padding: 6px 0;\">\n"
"                                <div style=\"font-weight: 700;\">${object.company_id and object.company_id.name or ''}</div>\n"
"                                <div>${object.company_id and object.company_id.street or ''}</div>\n"
"                                <div>${object.company_id and object.company_id.zip or ''} ${object.company_id and object.company_id.city or ''}</div>\n"
"                                <div>VAT: ${object.company_id and object.company_id.vat or ''}</div>\n"
"                            </td>\n"
"                            <td style=\"vertical-align: top; width: 38%; text-align: center; padding: 6px 12px; font-weight: 700;\">\n"
"                                ${ctx.get('club_manual_subject') or ''}\n"
"                            </td>\n"
"                            <td style=\"vertical-align: top; width: 20%; text-align: right; padding: 6px 0;\">\n"
"                                <img src=\"/logo.png?company=${object.company_id%20and%20object.company_id.id%20or%200}\" style=\"max-height: 56px;\" alt=\"Company Logo\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-height: 1px; margin: 16px 0;\"/>\n"
"\n"
"                <div>\n"
"                    ${ctx.get('club_manual_body_html') or ''}\n"
"                </div>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-height: 1px; margin: 16px 0;\"/>\n"
"\n"
"                <table style=\"width: 100%; border-collapse: collapse; font-size: 12px; color: #555555;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"width: 50%; vertical-align: top;\">\n"
"                                Bank: ${object.company_id and object.company_id.bank_ids and object.company_id.bank_ids[0].acc_number or ''}\n"
"                            </td>\n"
"                            <td style=\"width: 50%; vertical-align: top; text-align: right;\">\n"
"                                Generated: ${ctx.get('club_manual_generated_at') and format_datetime(ctx.get('club_manual_generated_at')) or ''}\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

#. module: clubmanagement
#: model:mail.template,body_html:clubmanagement.mail_template_club_member_state_rule_error
msgid ""
"<div>\n"
"                <p>A rule execution failed.</p>\n"
"                <table style=\"border-collapse: collapse; width: 100%; max-width: 900px;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600; width: 35%;\">Rule</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.name or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Rule ID</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.id}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Member</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${ctx.get('club_rule_error_member_name') or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Member ID</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${ctx.get('club_rule_error_member_id') or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Error</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${ctx.get('club_rule_error_message') or ''}</td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"                <p>Traceback (full):</p>\n"
"                <pre>${ctx.get('club_rule_error_trace') or ''}</pre>\n"
"            </div>\n"
"        "
msgstr ""

#. module: clubmanagement
#: model:mail.template,body_html:clubmanagement.mail_template_member_registration_success
msgid ""
"<div>\n"
"                <p>Hello ${object.firstname or object.name},</p>\n"
"                <p>Your registration was successfully received and processed.</p>\n"
"                <table style=\"border-collapse: collapse; width: 100%; max-width: 720px;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600; width: 35%;\">Last name</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.lastname or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">First name</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.firstname or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Birthdate</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.birthdate_date and format_date(object.birthdate_date) or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Address</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${(object.street or '') + (object.street2 and (' ' + object.street2) or '') + ((object.zip or object.city) and ' ' or '') + (object.zip or '') + ((object.zip and object.city) and ' ' or '') + (object.city or '')}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Registration date</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.create_date and format_datetime(object.create_date) or ''}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Current state</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${ctx.get('club_registration_state_name') or (object.current_state_id and object.current_state_id.name) or 'Not set'}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Member ID</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\">${object.member_id or ''}</td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"                <p>Thank you.</p>\n"
"            </div>\n"
"        "
msgstr ""

