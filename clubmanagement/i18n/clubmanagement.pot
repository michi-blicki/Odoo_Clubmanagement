"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"object.lastname or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">First name</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"object.firstname or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Birthdate</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"object.birthdate_date and format_date(object.birthdate_date) or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Address</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"(object.street or '') + (object.street2 and (' ' + object.street2) or '') + ((object.zip or object.city) and ' ' or '') + (object.zip or '') + ((object.zip and object.city) and ' ' or '') + (object.city or '')\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Registration date</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"object.create_date and format_datetime(object.create_date) or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Current state</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"ctx.get('club_registration_state_name') or (object.current_state_id and object.current_state_id.name) or 'Not set'\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px; font-weight: 600;\">Member ID</td>\n"
"                            <td style=\"border: 1px solid #d9d9d9; padding: 8px;\"><t t-out=\"object.member_id or ''\"/></td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"                <p>Odoo Club Management System</p>\n"
"            </div>\n"
"        "
msgstr ""

