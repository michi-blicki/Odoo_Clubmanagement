"                            </td>\n"
"                            <td style=\"vertical-align: top; width: 20%; "
"text-align: right; padding: 6px 0;\">\n"
"                                <img src=\"/logo.png?company=$"
"{object.company_id%20and%20object.company_id.id%20or%200}\" style=\"max-"
"height: 56px;\" alt=\"Company Logo\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-"
"height: 1px; margin: 16px 0;\"/>\n"
"\n"
"                <div>\n"
"                    ${ctx.get('club_manual_body_html') or ''}\n"
"                </div>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-"
"height: 1px; margin: 16px 0;\"/>\n"
"\n"
