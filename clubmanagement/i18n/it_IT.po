"object.company_id.vat or ''}</div>\n"
"                            </td>\n"
"                            <td style=\"vertical-align: top; width: 38%; "
"text-align: center; padding: 6px 12px; font-weight: 700;\">\n"
"                                ${ctx.get('club_manual_subject') or ''}\n"
"                            </td>\n"
"                            <td style=\"vertical-align: top; width: 20%; "
"text-align: right; padding: 6px 0;\">\n"
"                                <img src=\"/logo.png?company=$"
"{object.company_id%20and%20object.company_id.id%20or%200}\" style=\"max-"
"height: 56px;\" alt=\"Company Logo\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-"
"height: 1px; margin: 16px 0;\"/>\n"
"\n"
"                <div>\n"
"                    ${ctx.get('club_manual_body_html') or ''}\n"
"                </div>\n"
"\n"
"                <hr style=\"background-color: #cccccc; border: none; min-"
"height: 1px; margin: 16px 0;\"/>\n"
"\n"
"                <table style=\"width: 100%; border-collapse: collapse; font-"
"size: 12px; color: #555555;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"width: 50%; vertical-align: top;\">\n"
"                                Bank: ${object.company_id and "
"object.company_id.bank_ids and object.company_id.bank_ids[0].acc_number or "
"''}\n"
"                            </td>\n"
"                            <td style=\"width: 50%; vertical-align: top; "
"text-align: right;\">\n"
"                                Generated: $"
"{ctx.get('club_manual_generated_at') and "
"format_datetime(ctx.get('club_manual_generated_at')) or ''}\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
