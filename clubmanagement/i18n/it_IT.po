"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"vertical-align: top; width: 42%; "
"padding: 6px 0;\">\n"
"                                <div style=\"font-weight: 700;\">$"
"{object.company_id and object.company_id.name or ''}</div>\n"
"                                <div>${object.company_id and "
"object.company_id.street or ''}</div>\n"
"                                <div>${object.company_id and "
"object.company_id.zip or ''} ${object.company_id and object.company_id.city "
