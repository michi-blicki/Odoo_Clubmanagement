<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_member_state_change_wizard_form" model="ir.ui.view">
        <field name="name">club.member.state.change.wizard.form</field>
        <field name="model">club.member.state.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Member State" create="0" edit="0" delete="0">
                <group>
                    <field name="member_id"/>
                    <field name="current_state_id"/>
                    <field name="target_state_id" options="{'no_create': True}"/>
                    <field name="start_date"/>
                    <field name="reason" placeholder="Optional reason for this state change..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
