<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="club_member_waiting_kanban_view" model="ir.ui.view">
        <field name="name">club.member.waiting.kanban</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="gender"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="birthdate_date"/>
                <field name="state_days_in_state"/>
                <field name="state_date_start"/>
                <field name="city"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_club_member_kanban">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_card_header_title" width="100%">
                                    <h2>
                                        <t t-if="record.gender.raw_value == 'male'"><i title="Male" class="fa fa-mars" style="color: #0000FF"/> </t>
                                        <t t-if="record.gender.raw_value == 'female'"><i title="Female" class="fa fa-venus" style="color: #FF69B4"/> </t>
                                        <t t-if="record.gender.raw_value == 'others'"><i title="Other" class="fa fa-genderless" style="color: #6C757D"/> </t>
                                        <span class="ms-1"><field name="firstname"/></span>
                                        <span class="ms-1"><field name="lastname"/></span>
                                    </h2>
                                </div>
                                <hr class="mb-3 mt-2"/>
                                <table class="o_kanban_card_content" width="100%">
                                    <tr>
                                        <td>Birthdate:</td>
                                        <td><strong><field name="birthdate_date"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td>Waiting since:</td>
                                        <td>
                                            <strong>
                                                <t t-esc="record.state_days_in_state.value"/> days
                                                (<field name="state_date_start"/>)
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>City:</td>
                                        <td><strong><field name="city"/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="club_member_waiting_list_view" model="ir.ui.view">
        <field name="name">club.member.waiting.list</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <list string="Active Members" default_order="lastname">
                <field name="member_id" />
                <field name="partner_id" optional="hide" />
                <field name="lastname" />
                <field name="firstname" />
                <field name="birthdate_date" />
                <field name="year_of_birth" optional="hide" />
                <field name="age" optional="hide" />
                <field name="requires_guardian" optional="hide" />
                <field name="nationality_id" />
                <field name="city" />
                <field name="subclub_ids" widget="many2many_tags" options="{'no_create': True}" optional="show" />
                <field name="department_ids" widget="many2many_tags" options="{'no_create': True}" optional="hide" />
                <field name="team_ids" widget="many2many_tags" options="{'no_create': True}" optional="hide" />
                <field name="current_state_id" optional="hide" />
                <field name="current_membership_id" optional="hide" />
                <field name="state_date_start" />
                <field name="months_in_club" />
                <field name="guardian_ids" widget="many2many_tags" options="{'no_create': True}" optional="hide" />
            </list>
        </field>
    </record>

    <record id="club_member_waiting_list_action" model="ir.actions.act_window">
        <field name="name">Club Member: Waiting List</field>
        <field name="res_model">club.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[
            (5,0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('club_member_waiting_kanban_view')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('club_member_waiting_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('club_member_form_view')}),
        ]"/>
        <field name="domain">[
            "|",
            ('current_state_id.state_type', '=', 'pending'),
            ('current_state_id.state_type', '=', 'registered')
        ]</field>
        <field name="search_view_id" ref="club_member_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>New Club Members currently waiting to be accepted.</p>
        </field>
    </record>

    <menuitem
        id="club_member_waiting_list_menu"
        name="Waiting List"
        action="club_member_waiting_list_action"
        groups="clubmanagement.group_clubmanagement_user"
        parent="club_member_main_menu"
        sequence="20"/>

</odoo>
