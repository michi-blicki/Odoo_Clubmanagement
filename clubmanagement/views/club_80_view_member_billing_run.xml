<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="club_member_billing_run_list_view" model="ir.ui.view">
        <field name="name">club.member.billing.run.list</field>
        <field name="model">club.member.billing.run</field>
        <field name="arch" type="xml">
            <list string="Billing Runs" default_order="id desc">
                <field name="name"/>
                <field name="run_type"/>
                <field name="billing_year"/>
                <field name="run_date"/>
                <field name="company_id"/>
                <field name="club_id"/>
                <field name="journal_id"/>
                <field name="state"/>
                <field name="draft_move_count"/>
            </list>
        </field>
    </record>

    <record id="club_member_billing_run_form_view" model="ir.ui.view">
        <field name="name">club.member.billing.run.form</field>
        <field name="model">club.member.billing.run</field>
        <field name="arch" type="xml">
            <form string="Billing Run">
                <header>
                    <button name="action_generate_draft_invoices" type="object" string="Generate Draft Invoices" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_prepare_rerun_cleanup" type="object" string="Prepare Rerun Cleanup" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="run_type"/>
                            <field name="billing_year"/>
                            <field name="run_date"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="club_id"/>
                            <field name="journal_id"/>
                            <field name="rerun_of_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="replaced_run_ids" widget="many2many_tags" readonly="1"/>
                        <field name="note"/>
                    </group>

                    <notebook>
                        <page string="Run Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="member_id"/>
                                    <field name="membership_id"/>
                                    <field name="invoice_partner_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="move_id"/>
                                    <field name="has_error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Messages">
                            <div class="oe_chatter">
                                <field name="message_follower_ids" widget="mail_followers"/>
                                <field name="activity_ids" widget="mail_activity"/>
                                <field name="message_ids" widget="mail_thread"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="club_member_billing_run_action" model="ir.actions.act_window">
        <field name="name">Billing Runs</field>
        <field name="res_model">club.member.billing.run</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('club_member_billing_run_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('club_member_billing_run_form_view')})
        ]"/>
    </record>

    <menuitem
        id="club_member_billing_run_menu"
        name="Billing Runs"
        parent="club_administration_finance_menu"
        action="club_member_billing_run_action"
        groups="clubmanagement.group_clubmanagement_master_user"
        sequence="10"/>

</odoo>
