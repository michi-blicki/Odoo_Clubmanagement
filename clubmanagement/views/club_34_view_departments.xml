<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="club_department_overview_form_view" model="ir.ui.view">
        <field name="name">club.department.overview.form.view</field>
        <field name="model">club.department</field>
        <field name="arch" type="xml">
            <form string="Department Overview">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                            <span class="ml-2" invisible="active == True">
                                (<span style="color:red;">Archived</span>)
                            </span>
                        </h1>
                    </div>
                    <header>
                        <field name="active" />
                    </header>
                    <group>
                        <group>
                            <field name="sequence" readonly="1"/>
                        </group>
                        <group>
                            <field name="subclub_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="hr_department_id" readonly="1"/>
                            <field name="registration_mode" readonly="1"/>
                            <field name="effective_registration_mode" readonly="1"/>
                        </group>
                        <group>
                            <field name="members_count" readonly="1" string="Members"/>
                            <field name="account_analytic_account_id" readonly="1"/>
                            <field name="effective_membership_id" readonly="1"/>
                            <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="custom_field_lines" widget="clubmanagement_custom_fields"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="firstname"/>
                                    <field name="lastname"/>
                                    <field name="age" />
                                    <field name="years_in_club"/>
                                    <field name="current_state_id"/>
                                    <field name="team_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pools">
                            <field name="pool_ids" readonly="1" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="effective_membership_id" readonly="1"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Teams">
                            <field name="team_ids" readonly="1" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="effective_membership_id" readonly="1"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Boards">
                            <field name="board_ids" readonly="1" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="group_type" />
                                </list>
                            </field>
                        </page>
                        <page string="Roles / Functions">
                            <field name="role_ids">
                                <list>
                                    <field name="role_type"/>
                                    <field name="scope_type"/>
                                    <field name="member_id"/>
                                    <field name="perm_read"/>
                                    <field name="perm_write"/>
                                    <field name="perm_create"/>
                                    <field name="perm_unlink"/>
                                    <field name="perm_mail"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>