<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_member_mail_wizard_form" model="ir.ui.view">
        <field name="name">club.member.mail.wizard.form</field>
        <field name="model">club.member.mail.wizard</field>
        <field name="arch" type="xml">
            <form string="Member Mail Dispatch" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="target_model" readonly="1"/>
                        <field name="target_record_count" readonly="1"/>
                        <field name="member_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="queued_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="failed_count" readonly="1"/>
                    </group>
                </group>

                <group invisible="state == 'done'">
                    <field name="subject" required="1"/>
                    <field name="body_text" widget="html" required="1" options="{'style-inline': true}"/>
                    <field name="scheduled_date"/>
                </group>

                <group invisible="state != 'done'">
                    <label for="result_summary_html" string="Dispatch finished. Review the log below for queued, skipped and failed recipients."/>
                    <field name="result_summary_html" widget="html" nolabel="1" readonly="1"/>
                </group>

                <notebook>
                    <page string="Preview" invisible="state != 'preview'">
                        <group>
                            <group>
                                <field name="preview_member_id" readonly="1"/>
                                <field name="preview_recipient_email" readonly="1"/>
                            </group>
                            <group>
                                <field name="preview_email_from" readonly="1"/>
                                <field name="preview_subject" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="preview_body_html" widget="html" nolabel="1" readonly="1"/>
                        </group>
                    </page>
                    <page string="Dispatch Log">
                        <field name="line_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="member_id"/>
                                <field name="recipient_email"/>
                                <field name="status"/>
                                <field name="mail_mail_id"/>
                                <field name="reason"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn btn-primary" invisible="state == 'done'"/>
                    <button name="action_send" type="object" string="Queue Emails" class="btn btn-primary" invisible="state != 'preview'"/>
                    <button string="Close" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_club_member_mail_wizard_from_member" model="ir.actions.act_window">
        <field name="name">Send Member Email</field>
        <field name="res_model">club.member.mail.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_club_member_mail_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="clubmanagement.model_club_member"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('clubmanagement.group_clubmanagement_key_user')])]"/>
    </record>

