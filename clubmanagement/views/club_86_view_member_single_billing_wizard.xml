<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_member_single_billing_wizard_form" model="ir.ui.view">
        <field name="name">club.member.single.billing.wizard.form</field>
        <field name="model">club.member.single.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Single Member Billing" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="member_count" readonly="1"/>
                        <field name="member_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <group>
                        <field name="company_id"/>
                        <field name="club_id" readonly="1"/>
                        <field name="journal_id"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="run_date"/>
                        <field name="billing_year"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </group>

                <footer>
                    <button name="action_generate_draft_invoices" type="object" string="Generate Draft Invoices" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_club_member_single_billing_wizard_from_member" model="ir.actions.act_window">
        <field name="name">Generate Member Invoice</field>
        <field name="res_model">club.member.single.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_club_member_single_billing_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="clubmanagement.model_club_member"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('clubmanagement.group_clubmanagement_key_user')])]"/>
    </record>

</odoo>
