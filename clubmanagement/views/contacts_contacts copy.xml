<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <record id="res_partner_form_add_club_member" model="ir.ui.view">
            <field name="name">res.partner.form.add.club.member</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="99"/>
            <field name="inherit_id" eval="ref('base.view_partner_form')"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_create_club_member" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-plus"
                            string="Create Club Member"
                            invisible="is_club_member == True" />
                            
                    <button name="action_remove_club_member" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-minus"
                            string="Remove Club Member"
                            invisible="is_club_member == False" />
                </xpath>

                <xpath expr="//field[@name='street2']" position="after">
                    <field name="pobox" placeholder="P.O. Box"/>
                </xpath>

                <xpath expr="//field[@name='phone']" position="replace">
                    <field name="phone" placeholder="Phone" widget="phone" invisible="not is_company"/>
                    <field name="phone_fix_home" placeholder="Home Phone" invisible="is_company" widget="phone"/>
                    <field name="phone_fix_work" placeholder="Work Phone" invisible="is_company" widget="phone"/>
                </xpath>

                <xpath expr="//field[@name='mobile']" position="replace">
                    <field name="mobile" placeholder="Primary Mobile" widget="phone"/>
                    <field name="mobile2" placeholder="Secondary Mobile" invisible="is_company" widget="phone"/>
                    <field name="mobile_work" placeholder="Work Mobile" invisible="is_company" widget="phone"/>
                </xpath>

                <xpath expr="//field[@name='email']" position="after">
                    <br />
                    <field name="email2" placeholder="Secondary Email" widget="email"/>
                    <br />
                    <field name="email_work" placeholder="Work Email" invisible="is_company" widget="email"/>
                </xpath>

                <xpath expr="//field[@name='vat']" position="after">
                    <field name="ssnid"/>
                    <field name="is_club_member" readonly="1" invisible="is_company"/>
                    <field name="club_member_id" readonly="1" invisible="is_company"/>
                </xpath>

            </field>
        </record>
    
        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="domain" eval="[('is_club_member', '=', False)]"/>
        </record>

        <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
            <field name="sequence" eval="90" />
        </record>

        <record id="clubmanagement.action_club_contacts" model="ir.actions.act_window">
            <field name="name">Club Contacts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain" eval="[('is_club_member', '=', True)]" />
        </record>

        <menuitem id="clubmanagement.menu_contacts_club"
            name="Club Contacts"
            parent="contacts.menu_contacts"
            action="clubmanagement.action_club_contacts"
            groups="clubmanagement.group_clubmanagement_master_user"
            sequence="10"/>
    
    </data>
    

</odoo>
