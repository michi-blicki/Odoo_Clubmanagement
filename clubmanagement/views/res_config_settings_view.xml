<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_clubmanagement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.clubmanagement</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Club Management" string="Club Management" name="club_management" logo="/clubmanagement/static/src/img/icon.png"
                    groups="clubmanagement.group_clubmanagement_administrator">
                    <block title="General" name="clubgeneral_setting_container">
                        <setting id="majority_setting" title="Legal Majority Age">
                            <field name="force_guardian_requirement" />
                            <field name="club_age_of_majority" invisible='force_guardian_requirement == False'/>
                        </setting>
                        <setting id="start_member_id_setting" title="Start Member ID">
                            <field name="start_member_id" readonly='start_member_id_set'/>
                            <field name="start_member_id_set" invisible="True" />
                        </setting>
                    </block>

                    <block title="API Security" name="clubapi_setting_container">
                        <setting id="api_rate_limit_enable" title="Enable API Rate Limit">
                            <field name="club_api_rate_limit_enabled"/>
                        </setting>
                        <setting id="api_rate_limit_count" title="Requests per IP per Minute">
                            <field name="club_api_rate_limit_count" invisible="club_api_rate_limit_enabled == False"/>
                        </setting>
                    </block>

                    <block title="Membership Billing" name="clubmembership_billing_setting_container">
                        <setting id="default_invoice_grouping_mode_setting" title="Default Invoice Grouping Mode">
                            <field name="club_invoice_grouping_mode"/>
                        </setting>
                        <setting id="default_minor_invoice_source_setting" title="Default Minor Debtor Source">
                            <field name="club_minor_invoice_source"/>
                        </setting>
                        <setting id="membership_billing_journal_setting" title="Default Membership Billing Journal">
                            <field name="membership_billing_journal_id"/>
                        </setting>
                        <setting id="member_default_receivable_account_setting" title="Default Member Debtor Account">
                            <field name="member_default_receivable_account_id"/>
                        </setting>
                        <setting id="member_default_payable_account_setting" title="Default Member Creditor Account">
                            <field name="member_default_payable_account_id"/>
                        </setting>
                    </block>

                    <block title="Registration" name="clubregistration_setting_container">
                        <setting id="registration_success_mail_enabled_setting" title="Send Registration Success Mail">
                            <field name="registration_success_mail_enabled"/>
                        </setting>
                        <setting id="registration_success_on_manual_create_setting" title="Trigger Registration Success on Manual Member Create">
                            <field name="registration_success_on_manual_create"/>
                        </setting>
                    </block>

                    <block title="Organization Menu" name="cluborganizationmenu_setting_container">
                        <setting id="rebuild_team_menu_setting" title="Rebuild Team Menu Structure">
                            <button name="action_rebuild_team_menu_structure"
                                type="object"
                                string="Rebuild Team Menu"
                                class="btn btn-primary"/>
                        </setting>
                        <setting id="rebuild_pool_menu_setting" title="Rebuild Pool Menu Structure">
                            <button name="action_rebuild_pool_menu_structure"
                                type="object"
                                string="Rebuild Pool Menu"
                                class="btn btn-primary"/>
                        </setting>
                        <setting id="rebuild_department_menu_setting" title="Rebuild Department Menu Structure">
                            <button name="action_rebuild_department_menu_structure"
                                type="object"
                                string="Rebuild Department Menu"
                                class="btn btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="clubmanagement_config_settings_action" model="ir.actions.act_window">
        <field name="name">Club Management Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'clubmanagement', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_clubmanagement_settings"
            name="Settings"
            parent="base.menu_administration"
            sequence="80"
            action="clubmanagement_config_settings_action"
            groups="clubmanagement.group_clubmanagement_administrator"/>

    <menuitem id="menu_clubmanagement_admin_settings"
            name="Settings"
            parent="club_administration_setting_menu"
            sequence="1000"
            action="clubmanagement_config_settings_action"
            groups="clubmanagement.group_clubmanagement_administrator"/>

</odoo>
