<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_member_transfer_wizard_form" model="ir.ui.view">
        <field name="name">club.member.transfer.wizard.form</field>
        <field name="model">club.member.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Members" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="member_count" readonly="1"/>
                        <field name="member_ids" widget="many2many_tags" readonly="1"/>
                        <field name="multi_team_member_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="transfer_mode"/>
                        <field name="target_scope" readonly="transfer_mode == 'add_team'"/>
                        <field name="allow_replace_multi_team" invisible="transfer_mode != 'replace' or target_scope != 'team'"/>
                    </group>
                </group>

                <group>
                    <field name="target_subclub_id" invisible="target_scope != 'subclub'" required="target_scope == 'subclub'"/>
                    <field name="target_department_id" invisible="target_scope != 'department'" required="target_scope == 'department'"/>
                    <field name="target_pool_id" invisible="target_scope != 'pool'" required="target_scope == 'pool'"/>
                    <field name="target_team_id" invisible="target_scope != 'team'" required="target_scope == 'team'"/>
                </group>

                <footer>
                    <button name="action_apply_transfer" type="object" string="Apply Transfer" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_club_member_transfer_wizard_from_member" model="ir.actions.act_window">
        <field name="name">Transfer Members</field>
        <field name="res_model">club.member.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_club_member_transfer_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="clubmanagement.model_club_member"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('clubmanagement.group_clubmanagement_key_user')])]"/>
    </record>

</odoo>
