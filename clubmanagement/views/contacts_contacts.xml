<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <record id="res_partner_form_add_club_member" model="ir.ui.view">
            <field name="name">res.partner.form.add.club.member</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" eval="ref('base.view_partner_form')"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <button name="action_create_club_member" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-plus"
                            string="Create Club Member"
                            invisible="club_member_id == False" />
                            
                    <button name="action_remove_club_member" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-minus"
                            string="Remove Club Member"
                            invisible="club_member_id != False" />
                </xpath>
            </field>
        </record>

        <record id="personal_information_inherit" model="ir.ui.view">
            <field name="name">partner_contact_personal_information_page.personal_information.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" eval="ref('partner_contact_personal_information_page.personal_information')"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='personal_information_group']" position="replace">
                    <group name="personal_information_group">
                        <group string="Personal">
                            <field name="gender" />
                            <field name="nationality_id" />
                        </group>
                        <group string="Birthdate">
                            <field name="birthdate_date" />
                            <field name="age" readonly="1" />
                        </group>
                        <group string="Club Membership">
                            <field name="club_member_id" readonly="1" />
                            <field name="is_club_member" readonly="1" />
                        </group>
                    </group>
                </xpath>
            </field>                        
        </record>

        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="domain" eval="[('club_member_id', '=', False)]"/>
        </record>

        <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
            <field name="sequence" eval="90" />
        </record>

        <record id="clubmanagement.action_club_contacts" model="ir.actions.act_window">
            <field name="name">Club Contacts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain" eval="[('club_member_id', '!=', False)]" />
        </record>

        <menuitem id="clubmanagement.menu_contacts_club"
            name="Club Contacts"
            parent="contacts.menu_contacts"
            action="clubmanagement.action_club_contacts"
            groups="clubmanagement.group_clubmanagement_master_user"
            sequence="10"/>
    
    </data>
    

</odoo>
