        <!-- Teams for club_dept_active_man -->
        
        <!-- Football League Championship Team -->
        <record id="ac_team_championship" model="account.analytic.account">
            <field name="name">Active Man - Team Championship</field>
            <field name="code">211000</field>
            <field name="plan_id" ref="ac_plan_main_club"/>
            <field name="parent_id" ref="ac_dept_main_active_man"/>
            <field name="company_id" ref="manchester_nebula_fc_main_club"/>
            <field name="currency_id" ref="base.GBP"/>
        </record>
        <record id="team_championship" model="club.team">
            <field name="name">Manchester Nebula FC Championship</field>
            <field name="shortname">MNFC</field>
            <field name="company_id" ref="manchester_nebula_fc_main_club"/>
            <field name="club_id" ref="manchester_nebula_fc_club"/>
            <field name="department_id" ref="club_dept_main_active_man"/>
            <field name="hr_department_id" ref="dept_active_man"/>
            <field name="account_analytic_account_id" ref="ac_team_championship"/>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>

